<div class="list-groups">
  {% assign certificates = data[1] | sort: 'startDate' | reverse %}
  {% for content in certificates %}
    <div class="list-group col-md-6">
      <table class="table-cv list-group-table">
        <tbody>
          <tr>
            {% if content.icon %}
              <td class="list-group-category-icon">
                <i class="{{ content.icon }}"></i>
              </td>
            {% else %}
              <td class="list-group-category-icon"></td>
            {% endif %}
            <td colspan="2" class="list-group-category">{{ content.name }}</td>
          </tr>
          <tr>
            <td></td>
            <td colspan="2" class="list-group-name" style="font-style: italic">{{ content.issuer }}</td>
          </tr>
          <tr>
            <td></td>
            <td colspan="2" class="list-group-name">
              {% if content.startDate %}Issued {{ content.startDate | date: '%b %Y' }}{% endif %}
              {% if content.endDate %} &middot; Expires {{ content.endDate | date: '%b %Y' }}{% endif %}
            </td>
          </tr>
          {% if content.credentialId %}
            <tr>
              <td></td>
              <td colspan="2" class="list-group-name">Credential ID: {{ content.credentialId }}</td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>
  {% endfor %}
</div>
